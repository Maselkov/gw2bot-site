{
  "name": "gw2bot-site",
  "version": "1.1.2",
  "description": "The website of GW2Bot, a Discord bot",
  "author": "Matt Bryant, Muhammed Bacalan",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "generate": "nuxt generate",
    "postinstall": "nuxt prepare",
    "lint": "npm run lint:js && npm run lint:style",
    "lint:js": "eslint .",
    "lint:style": "stylelint \"**/*.{scss,vue}\" --ignore-path .gitignore",
    "test": "node --test \"tests/api/**/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test:e2e:docker": "docker run --rm --network host --ipc host -u \"$(id -u):$(id -g)\" -e HOME=/tmp -e CI -e BASE_URL -v \"$PWD\":/work -w /work mcr.microsoft.com/playwright:v1.64.1-noble npx playwright test"
  },
  "dependencies": {
    "@nuxtjs/color-mode": "^4.0.1",
    "floating-vue": "^5.4.0",
    "lazysizes": "^5.3.2",
    "mongodb": "^7.7.0",
    "nuxt": "^4.6.2",
    "rellax": "^1.12.1",
    "sass": "^1.105.2"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "1.64.1",
    "eslint": "^10.13.0",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-config-standard-vue": "^2.0.0",
    "vite-imagetools": "^12.0.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">= 10.1.0"
  }
}
