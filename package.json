{
  "name": "gw2bot-site",
  "version": "1.1.2",
  "description": "The website of GW2Bot, a Discord bot",
  "author": "Matt Bryant, Muhammed Bacalan",
  "private": true,
  "scripts": {
    "dev": "nuxt",
    "build": "nuxt build",
    "start": "nuxt start",
    "generate": "nuxt generate",
    "lint": "eslint --ext .js,.vue --ignore-path .gitignore .",
    "test": "node --test \"tests/api/**/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test:e2e:docker": "docker run --rm --network host --ipc host -u \"$(id -u):$(id -g)\" -e HOME=/tmp -e CI -e BASE_URL -v \"$PWD\":/work -w /work mcr.microsoft.com/playwright:v1.64.1-noble npx playwright test"
  },
  "dependencies": {
    "@nuxtjs/color-mode": "^2.1.1",
    "@nuxtjs/style-resources": "^1.2.2",
    "express": "^4.18.2",
    "floating-vue": "^1.0.0-beta.19",
    "lazysizes": "^5.3.2",
    "mongodb": "^5.9.2",
    "node-fetch": "^3.3.2",
    "nuxt": "^2.17.3",
    "rellax": "^1.12.1",
    "sass": "^1.69.7",
    "sass-loader": "^10.5.2"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.23.3",
    "@nuxtjs/eslint-config": "^12.0.0",
    "@nuxtjs/eslint-module": "^3.1.0",
    "@nuxtjs/stylelint-module": "^4.2.2",
    "@playwright/test": "1.64.1",
    "eslint-plugin-nuxt": "^4.0.0",
    "postcss-html": "^1.6.0",
    "responsive-loader": "^2.3.0",
    "sharp": "^0.33.2",
    "stylelint": "^15.11.0",
    "stylelint-config-standard-scss": "^11.0.0",
    "stylelint-config-standard-vue": "^1.0.0",
    "vue-eslint-parser": "^9.4.0"
  },
  "overrides": {
    "webpack-dev-middleware": "5.0.0"
  },
  "engines": {
    "node": ">= 18.18.0",
    "npm": ">= 10.1.0"
  }
}
